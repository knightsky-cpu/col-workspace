# Local credentials and environment
.env
.env.*
*.pem
*.key
*.p12
*credentials*
*service-account*
application_default_credentials.json

# Repository and agent workspace state
.git
.agents

# Python environments and caches
venv
.venv
__pycache__
*.pyc
.pytest_cache
